---
import BaseLayout from '../components/BaseLayout.astro';
---

<BaseLayout title="Solutions — Jakar Industries" description="Comprehensive mission solutions for defense, public safety, and innovation.">
  <div class="ng-layout">
    <!-- Hero Section -->
    <div class="ng-hero">
      <video class="ng-hero-video" autoplay loop muted playsinline>
        <source src="/videos/hero-contact.mp4" type="video/mp4" />
      </video>
      <div class="ng-hero-overlay">
        <div class="ng-hero-content">
          <h1 class="ng-h1">Solutions</h1>
          <p class="ng-subtitle">Integrated systems for critical operations</p>
        </div>
      </div>
    </div>

    <!-- Black Breadcrumb Bar -->
    <div class="ng-breadcrumb-bar">
      <nav class="ng-breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li class="ng-sep">></li>
          <li class="current">Solutions</li>
        </ol>
      </nav>
    </div>

    <!-- White Content Area -->
    <div class="ng-white-content">
      <div class="ng-container">
        <div class="ng-intro-section">
          <h2 class="ng-h2">Operational Impact</h2>
          <p class="ng-p">We deliver end-to-end solutions that address the most complex challenges in modern security. By integrating hardware, software, and human expertise, we create force multipliers for those on the front lines of defense and public safety.</p>
        </div>

        <div class="ng-solutions-grid">
          <div class="ng-sol-card">
            <h3 class="ng-h3">Defense Operations</h3>
            <p class="ng-p">Modernizing the battlefield with intelligent systems that provide superior reconnaissance, target acquisition, and tactical communications in contested environments.</p>
            <ul class="ng-list">
              <li><strong class="ng-blue-text">Electronic Warfare:</strong> Spectrum dominance</li>
              <li><strong class="ng-blue-text">Precision Logistics:</strong> Real-time supply chains</li>
              <li><strong class="ng-blue-text">Battlefield AI:</strong> Cognitive advantage</li>
            </ul>
          </div>

          <div class="ng-sol-card">
            <h3 class="ng-h3">First Responders</h3>
            <p class="ng-p">Equipping public safety agencies with tools for rapid disaster response, urban search and rescue, and large-scale incident management under extreme conditions.</p>
            <ul class="ng-list">
              <li><strong class="ng-blue-text">Robotics:</strong> Search & rescue platforms</li>
              <li><strong class="ng-blue-text">Detection:</strong> Chemical & radiation sensing</li>
              <li><strong class="ng-blue-text">Command:</strong> Mobile operational centers</li>
            </ul>
          </div>
        </div>

        <!-- Methodology Section -->
        <div class="ng-method-section">
          <h2 class="ng-h2">Our Methodology</h2>
          <div class="ng-method-grid">
            <div class="ng-method-item">
              <div class="ng-method-step-num">01</div>
              <h3 class="ng-h3-small">Mission Analysis</h3>
              <p class="ng-p-small">Understanding the unique constraints and requirements of your specific operational environment.</p>
            </div>
            <div class="ng-method-item">
              <div class="ng-method-step-num">02</div>
              <h3 class="ng-h3-small">System Design</h3>
              <p class="ng-p-small">Developing integrated solutions that leverage the best available technology for the mission.</p>
            </div>
            <div class="ng-method-item">
              <div class="ng-method-step-num">03</div>
              <h3 class="ng-h3-small">Support</h3>
              <p class="ng-p-small">Providing full logistics support and ongoing maintenance to ensure mission success.</p>
            </div>
          </div>
        </div>

        <!-- Final CTA -->
        <div class="ng-cta-section">
          <div class="ng-cta-card">
            <h2 class="ng-h2">Ready for the Future?</h2>
            <p class="ng-p">Explore how our integrated solutions can transform your operations.</p>
            <a href="/contact" class="ng-cta-button">Explore Case Studies</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* 1-to-1 Northrop Grumman Constants */
  :root {
    --ng-blue: #00269A;
    --ng-dark-navy: #002554;
    --ng-black: #000000;
    --ng-header-grey: #222222;
    --ng-body-grey: #444444;
    --ng-breadcrumb-link: #E9EBED;
    --ng-breadcrumb-active: #7C878E;
    --ng-font: "Inter", Arial, sans-serif;
    --ng-container-width: 1140px;
  }

  .ng-layout {
    background: var(--ng-black);
    font-family: var(--ng-font);
    -webkit-font-smoothing: antialiased;
  }

  /* Hero Section */
  .ng-hero {
    position: relative;
    height: 70vh;
    min-height: 550px;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .ng-hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ng-hero-overlay {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: var(--ng-container-width);
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  /* Exact 1-for-1 NG Overlay Styles */
  .ng-hero-content {
    background: rgba(0, 0, 0, 0.5); /* 50% Opacity */
    backdrop-filter: blur(5px);    /* 5px Blur */
    -webkit-backdrop-filter: blur(5px);
    padding: 40px;                 /* 40px Padding */
    color: #fff;
    border: none;
    text-align: left;
    max-width: 1140px;
    width: auto;
  }

  .ng-h1 {
    font-size: 52px;
    font-weight: 700;
    margin: 0 0 20px;
    line-height: 1.1;
  }

  .ng-subtitle {
    font-size: 24px;
    margin: 0;
    line-height: 1.4;
    font-weight: 400;
    opacity: 0.95;
  }

  /* Breadcrumb Bar */
  .ng-breadcrumb-bar {
    background: var(--ng-black);
    height: 70px;
    display: flex;
    align-items: center;
  }

  .ng-breadcrumb {
    width: 100%;
    max-width: var(--ng-container-width);
    margin: 0 auto;
    padding: 0 40px;
  }

  .ng-breadcrumb ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ng-breadcrumb li {
    font-size: 19.8px;
    font-weight: 500;
    color: var(--ng-breadcrumb-active);
  }

  .ng-breadcrumb a {
    color: var(--ng-breadcrumb-link);
    text-decoration: none;
  }

  .ng-sep {
    color: var(--ng-breadcrumb-active);
    font-size: 16px;
  }

  /* Main Content Area */
  .ng-white-content {
    background: #fff;
    color: var(--ng-body-grey);
    padding: 80px 0;
  }

  .ng-container {
    max-width: var(--ng-container-width);
    margin: 0 auto;
    padding: 0 40px;
  }

  .ng-intro-section {
    margin-bottom: 80px;
  }

  .ng-h2 {
    font-size: 44px;
    font-weight: 700;
    color: var(--ng-header-grey);
    margin: 0 0 30px;
    line-height: 1.2;
  }

  .ng-p {
    font-size: 18px;
    line-height: 1.75;
    margin-bottom: 30px;
  }

  .ng-solutions-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    margin-bottom: 80px;
  }

  .ng-sol-card {
    border-top: 1px solid #EDEDED;
    padding-top: 40px;
  }

  .ng-h3 {
    font-size: 32px;
    font-weight: 700;
    color: var(--ng-header-grey);
    margin-bottom: 25px;
  }

  .ng-list {
    list-style: none;
    padding: 0;
    margin: 30px 0 0;
  }

  .ng-list li {
    font-size: 17px;
    margin-bottom: 12px;
    padding-left: 20px;
    position: relative;
  }

  .ng-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 10px;
    width: 8px;
    height: 2px;
    background: var(--ng-blue);
  }

  .ng-blue-text {
    color: var(--ng-blue);
  }

  /* Methodology */
  .ng-method-section {
    background: #F2F4F5;
    padding: 80px 40px;
    margin-bottom: 80px;
  }

  .ng-method-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    margin-top: 40px;
  }

  .ng-method-item {
    background: #fff;
    padding: 40px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
  }

  .ng-method-step-num {
    font-size: 24px;
    font-weight: 700;
    color: var(--ng-blue);
    margin-bottom: 15px;
  }

  .ng-h3-small {
    font-size: 20px;
    font-weight: 700;
    color: var(--ng-header-grey);
    margin-bottom: 15px;
    text-transform: uppercase;
  }

  .ng-p-small {
    font-size: 16px;
    line-height: 1.6;
    margin: 0;
  }

  /* Final CTA */
  .ng-cta-section {
    text-align: center;
  }

  .ng-cta-card {
    background: var(--ng-dark-navy);
    color: #fff;
    padding: 80px 40px;
  }

  .ng-cta-button {
    display: inline-block;
    background: var(--ng-blue);
    color: #fff;
    padding: 20px 45px;
    text-decoration: none;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 15px;
    transition: background 0.3s;
    margin-top: 40px;
  }

  @media (max-width: 1024px) {
    .ng-solutions-grid { grid-template-columns: 1fr; }
    .ng-method-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 768px) {
    .ng-h1 { font-size: 38px; }
    .ng-h2 { font-size: 32px; }
    .ng-hero-content { padding: 40px; }
  }
</style>
