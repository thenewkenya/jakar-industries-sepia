---
import BaseLayout from '../components/BaseLayout.astro';
---

<BaseLayout title="Solutions — Jakar Industries" description="Comprehensive mission solutions for defense, public safety, and innovation.">
  <div class="minimal-layout">
    <!-- Hero Section -->
    <div class="minimal-hero">
      <video class="minimal-hero-video" autoplay loop muted playsinline>
        <source src="/videos/hero-contact.mp4" type="video/mp4" />
      </video>
      <div class="minimal-hero-overlay">
        <div class="minimal-hero-content">
          <h1 class="minimal-h1">Solutions</h1>
          <p class="minimal-subtitle">Integrated systems for critical operations</p>
        </div>
      </div>
    </div>

    <!-- Dark Breadcrumb Bar -->
    <div class="minimal-breadcrumb-bar">
      <nav class="minimal-breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li class="minimal-sep">></li>
          <li class="current">Solutions</li>
        </ol>
      </nav>
    </div>

    <!-- Dark Content Area -->
    <div class="minimal-dark-content">
      <div class="minimal-container">
        <div class="minimal-intro-section">
          <h2 class="minimal-h2">Operational Impact</h2>
          <p class="minimal-p">We deliver end-to-end solutions that address the most complex challenges in modern security. By integrating hardware, software, and human expertise, we create force multipliers for those on the front lines of defense and public safety.</p>
        </div>

        <div class="minimal-solutions-grid">
          <div class="minimal-sol-item">
            <h3 class="minimal-h3-alt">Defense Operations</h3>
            <p class="minimal-p">Modernizing the battlefield with intelligent systems that provide superior reconnaissance, target acquisition, and tactical communications in contested environments.</p>
            <ul class="minimal-list-alt">
              <li><strong class="minimal-accent-text">Electronic Warfare:</strong> <span class="minimal-gray-text">Spectrum dominance</span></li>
              <li><strong class="minimal-accent-text">Precision Logistics:</strong> <span class="minimal-gray-text">Real-time supply chains</span></li>
              <li><strong class="minimal-accent-text">Battlefield AI:</strong> <span class="minimal-gray-text">Cognitive advantage</span></li>
            </ul>
          </div>

          <div class="minimal-sol-item">
            <h3 class="minimal-h3-alt">First Responders</h3>
            <p class="minimal-p">Equipping public safety agencies with tools for rapid disaster response, urban search and rescue, and large-scale incident management under extreme conditions.</p>
            <ul class="minimal-list-alt">
              <li><strong class="minimal-accent-text">Robotics:</strong> <span class="minimal-gray-text">Search & rescue platforms</span></li>
              <li><strong class="minimal-accent-text">Detection:</strong> <span class="minimal-gray-text">Chemical & radiation sensing</span></li>
              <li><strong class="minimal-accent-text">Command:</strong> <span class="minimal-gray-text">Mobile operational centers</span></li>
            </ul>
          </div>
        </div>

        <!-- Methodology Section -->
        <div class="minimal-method-section">
          <h2 class="minimal-h2">Our Methodology</h2>
          <div class="minimal-method-grid">
            <div class="minimal-method-item">
              <div class="minimal-method-num">01</div>
              <h3 class="minimal-h3-small">Mission Analysis</h3>
              <p class="minimal-p-small">Understanding the unique constraints and requirements of your specific operational environment.</p>
            </div>
            <div class="minimal-method-item">
              <div class="minimal-method-num">02</div>
              <h3 class="minimal-h3-small">System Design</h3>
              <p class="minimal-p-small">Developing integrated solutions that leverage the best available technology for the mission.</p>
            </div>
            <div class="minimal-method-item">
              <div class="minimal-method-num">03</div>
              <h3 class="minimal-h3-small">Global Support</h3>
              <p class="minimal-p-small">Providing full logistics support and ongoing maintenance to ensure mission success.</p>
            </div>
          </div>
        </div>

        <!-- Final CTA -->
        <div class="minimal-cta-section">
          <div class="minimal-cta-card">
            <h2 class="minimal-h2">Ready for the Future?</h2>
            <p class="minimal-p">Explore how our integrated solutions can transform your operations.</p>
            <a href="/contact" class="minimal-cta-button">Explore Case Studies</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* Dribbble-Inspired Minimalist Dark Constants */
  :root {
    --minimal-black: #000000;
    --minimal-near-black: #0a0a0a;
    --minimal-accent: #0044ff;
    --minimal-white: #ffffff;
    --minimal-gray: #A0A0A0;
    --minimal-border: rgba(255, 255, 255, 0.1);
    --minimal-font: "Inter", -apple-system, sans-serif;
    --minimal-container: 1200px;
  }

  .minimal-layout {
    background: var(--minimal-black);
    color: var(--minimal-white);
    font-family: var(--minimal-font);
    -webkit-font-smoothing: antialiased;
  }

  /* Hero Section */
  .minimal-hero {
    position: relative;
    height: 70vh;
    min-height: 550px;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .minimal-hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.5;
  }

  .minimal-hero-overlay {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: var(--minimal-container);
    margin: 0 auto;
    padding: 0 40px;
  }

  .minimal-hero-content {
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    padding: 60px;
    max-width: 800px;
    border: 1px solid var(--minimal-border);
  }

  .minimal-h1 {
    font-size: clamp(48px, 8vw, 72px);
    font-weight: 800;
    margin: 0 0 20px;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .minimal-subtitle {
    font-size: clamp(18px, 2vw, 24px);
    margin: 0;
    line-height: 1.4;
    font-weight: 400;
    color: var(--minimal-gray);
  }

  /* Breadcrumb Bar */
  .minimal-breadcrumb-bar {
    background: var(--minimal-near-black);
    border-bottom: 1px solid var(--minimal-border);
    padding: 20px 0;
  }

  .minimal-breadcrumb {
    width: 100%;
    max-width: var(--minimal-container);
    margin: 0 auto;
    padding: 0 40px;
  }

  .minimal-breadcrumb ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .minimal-breadcrumb li {
    font-size: 13px;
    font-weight: 600;
    color: var(--minimal-gray);
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }

  .minimal-breadcrumb a { color: var(--minimal-white); text-decoration: none; }
  .minimal-sep { opacity: 0.3; }

  /* Content Area */
  .minimal-dark-content {
    background: var(--minimal-black);
    padding: 120px 0;
  }

  .minimal-container {
    max-width: var(--minimal-container);
    margin: 0 auto;
    padding: 0 40px;
  }

  .minimal-h2 {
    font-size: 40px;
    font-weight: 700;
    margin: 0 0 30px;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .minimal-p {
    font-size: 18px;
    line-height: 1.8;
    color: var(--minimal-gray);
    margin-bottom: 40px;
  }

  .minimal-solutions-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 100px;
    margin: 80px 0;
  }

  .minimal-sol-item {
    border-top: 1px solid var(--minimal-border);
    padding-top: 40px;
  }

  .minimal-h3-alt {
    font-size: 32px;
    font-weight: 700;
    margin-bottom: 25px;
  }

  .minimal-list-alt {
    list-style: none;
    padding: 0;
    margin: 30px 0 0;
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .minimal-accent-text {
    color: var(--minimal-white);
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .minimal-gray-text { color: var(--minimal-gray); }

  /* Methodology */
  .minimal-method-section {
    background: var(--minimal-near-black);
    border: 1px solid var(--minimal-border);
    padding: 100px 60px;
    margin: 120px 0;
  }

  .minimal-method-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 60px;
    margin-top: 60px;
  }

  .minimal-method-num {
    font-size: 14px;
    font-weight: 800;
    color: var(--minimal-accent);
    margin-bottom: 20px;
    background: rgba(0, 68, 255, 0.1);
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
  }

  .minimal-h3-small {
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 15px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .minimal-p-small {
    font-size: 15px;
    line-height: 1.6;
    color: var(--minimal-gray);
    margin: 0;
  }

  /* CTA Section */
  .minimal-cta-section {
    padding: 40px 0 0;
    text-align: center;
  }

  .minimal-cta-card {
    background: linear-gradient(135deg, #050505 0%, #111 100%);
    border: 1px solid var(--minimal-border);
    padding: 100px 60px;
  }

  .minimal-cta-button {
    display: inline-block;
    background: var(--minimal-white);
    color: var(--minimal-black);
    padding: 20px 50px;
    text-decoration: none;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-size: 14px;
    transition: all 0.3s;
    margin-top: 40px;
  }

  .minimal-cta-button:hover {
    background: var(--minimal-accent);
    color: var(--minimal-white);
    transform: translateY(-2px);
  }

  @media (max-width: 1024px) {
    .minimal-solutions-grid { grid-template-columns: 1fr; gap: 60px; }
    .minimal-method-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 768px) {
    .minimal-h1 { font-size: 40px; }
    .minimal-h2 { font-size: 32px; }
    .minimal-hero-content { padding: 40px; }
    .minimal-method-section { padding: 60px 30px; }
  }
</style>
