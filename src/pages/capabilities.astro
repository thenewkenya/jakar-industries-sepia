---
import BaseLayout from '../components/BaseLayout.astro';
---

<BaseLayout title="Capabilities — Jakar Industries" description="Explore our advanced mission technology and strategic platform capabilities.">
  <div class="ng-layout">
    <!-- Hero Section -->
    <div class="ng-hero">
      <video class="ng-hero-video" autoplay loop muted playsinline>
        <source src="/videos/hero-capabilities.mp4" type="video/mp4" />
      </video>
      <div class="ng-hero-overlay">
        <div class="ng-hero-content">
          <h1 class="ng-h1">Capabilities</h1>
          <p class="ng-subtitle">Advanced engineering for the modern mission</p>
        </div>
      </div>
    </div>

    <!-- Black Breadcrumb Bar -->
    <div class="ng-breadcrumb-bar">
      <nav class="ng-breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li class="ng-sep">></li>
          <li class="current">Capabilities</li>
        </ol>
      </nav>
    </div>

    <!-- White Content Area -->
    <div class="ng-white-content">
      <div class="ng-container">
        <div class="ng-intro-section">
          <h2 class="ng-h2">Mission Excellence</h2>
          <p class="ng-p">Jakar Industries provides high-end technological advantages across multiple domains. Our focus on rapid innovation and mission-proven reliability ensures that our partners stay ahead of emerging threats through superior engineering and operational expertise.</p>
        </div>

        <div class="ng-capabilities-grid">
          <div class="ng-cap-item">
            <h3 class="ng-h3">Advanced Sensors</h3>
            <p class="ng-p">Multispectral sensing systems providing real-time intelligence in degraded environments. Our sensor suites are designed for maximum situational awareness and seamless data integration.</p>
            <ul class="ng-list">
              <li><strong class="ng-blue-text">Imaging:</strong> Thermal & IR high-res systems</li>
              <li><strong class="ng-blue-text">LIDAR:</strong> Advanced terrain mapping</li>
              <li><strong class="ng-blue-text">ESM:</strong> Electronic support measures</li>
            </ul>
          </div>

          <div class="ng-cap-item">
            <h3 class="ng-h3">Autonomous Systems</h3>
            <p class="ng-p">Next-generation drones and ground robotic systems capable of autonomous navigation, threat detection, and collaborative operations in contested areas.</p>
            <ul class="ng-list">
              <li><strong class="ng-blue-text">AI Swarms:</strong> Collaborative unit intelligence</li>
              <li><strong class="ng-blue-text">Edge AI:</strong> Real-time processing power</li>
              <li><strong class="ng-blue-text">Endurance:</strong> Ultra-long mission logistics</li>
            </ul>
          </div>
        </div>

        <!-- Platforms Section -->
        <div class="ng-platforms-section">
          <h2 class="ng-h2">Strategic Platforms</h2>
          <div class="ng-platform-row">
            <div class="ng-platform-card">
              <div class="ng-platform-info">
                <h3 class="ng-h3">Aegis Drone Fleet</h3>
                <p class="ng-p">The Aegis platform represents the pinnacle of aerial surveillance. Capable of 24-hour continuous flight, these systems provide persistent monitoring for border security and disaster response.</p>
              </div>
            </div>
            <div class="ng-platform-card">
              <div class="ng-platform-info">
                <h3 class="ng-h3">Titan Ground Unit</h3>
                <p class="ng-p">A modular, heavy-duty robotic platform designed for hazardous material handling and extreme terrain navigation. Titan goes where humans cannot.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Final CTA Box -->
        <div class="ng-cta-section">
          <div class="ng-cta-card">
            <h2 class="ng-h2">Ready to Transform Your Mission?</h2>
            <p class="ng-p">Learn how our advanced capabilities can give you the operational advantage.</p>
            <a href="/contact" class="ng-cta-button">Contact Our Experts</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* 1-to-1 Northrop Grumman Constants */
  :root {
    --ng-blue: #00269A;
    --ng-dark-navy: #002554;
    --ng-black: #000000;
    --ng-header-grey: #222222;
    --ng-body-grey: #444444;
    --ng-breadcrumb-link: #E9EBED;
    --ng-breadcrumb-active: #7C878E;
    --ng-font: "Inter", Arial, sans-serif;
    --ng-container-width: 1140px;
  }

  .ng-layout {
    background: var(--ng-black);
    font-family: var(--ng-font);
    -webkit-font-smoothing: antialiased;
  }

  /* Hero Section */
  .ng-hero {
    position: relative;
    height: 70vh;
    min-height: 550px;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .ng-hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ng-hero-overlay {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: var(--ng-container-width);
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  /* Exact 1-for-1 NG Overlay Styles */
  .ng-hero-content {
    background: rgba(0, 0, 0, 0.5); /* 50% Opacity */
    backdrop-filter: blur(5px);    /* 5px Blur */
    -webkit-backdrop-filter: blur(5px);
    padding: 40px;                 /* 40px Padding */
    color: #fff;
    border: none;
    text-align: left;
    max-width: 1140px;
    width: auto;
  }

  .ng-h1 {
    font-size: 52px;
    font-weight: 700;
    margin: 0 0 20px;
    line-height: 1.1;
  }

  .ng-subtitle {
    font-size: 24px;
    margin: 0;
    line-height: 1.4;
    font-weight: 400;
    opacity: 0.95;
  }

  /* Breadcrumb Bar */
  .ng-breadcrumb-bar {
    background: var(--ng-black);
    height: 70px;
    display: flex;
    align-items: center;
  }

  .ng-breadcrumb {
    width: 100%;
    max-width: var(--ng-container-width);
    margin: 0 auto;
    padding: 0 40px;
  }

  .ng-breadcrumb ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ng-breadcrumb li {
    font-size: 19.8px;
    font-weight: 500;
    color: var(--ng-breadcrumb-active);
  }

  .ng-breadcrumb a {
    color: var(--ng-breadcrumb-link);
    text-decoration: none;
  }

  .ng-sep {
    color: var(--ng-breadcrumb-active);
    font-size: 16px;
  }

  /* Main Content Area */
  .ng-white-content {
    background: #fff;
    color: var(--ng-body-grey);
    padding: 80px 0;
  }

  .ng-container {
    max-width: var(--ng-container-width);
    margin: 0 auto;
    padding: 0 40px;
  }

  .ng-intro-section {
    margin-bottom: 80px;
  }

  .ng-h2 {
    font-size: 44px;
    font-weight: 700;
    color: var(--ng-header-grey);
    margin: 0 0 30px;
    line-height: 1.2;
  }

  .ng-p {
    font-size: 18px;
    line-height: 1.75;
    margin-bottom: 30px;
  }

  .ng-capabilities-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    margin-bottom: 80px;
  }

  .ng-cap-item {
    border-top: 1px solid #EDEDED;
    padding-top: 40px;
  }

  .ng-h3 {
    font-size: 32px;
    font-weight: 700;
    color: var(--ng-header-grey);
    margin-bottom: 25px;
  }

  .ng-list {
    list-style: none;
    padding: 0;
    margin: 30px 0 0;
  }

  .ng-list li {
    font-size: 17px;
    margin-bottom: 12px;
    padding-left: 20px;
    position: relative;
  }

  .ng-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 10px;
    width: 8px;
    height: 2px;
    background: var(--ng-blue);
  }

  .ng-blue-text {
    color: var(--ng-blue);
  }

  /* Platforms Section */
  .ng-platforms-section {
    padding: 80px 0;
    border-top: 1px solid #E5E5E5;
  }

  .ng-platform-row {
    display: grid;
    gap: 40px;
    margin-top: 40px;
  }

  .ng-platform-card {
    background: #F2F4F5;
    padding: 60px;
    border-left: 5px solid var(--ng-blue);
  }

  /* Final CTA */
  .ng-cta-section {
    padding: 80px 0 0;
    text-align: center;
  }

  .ng-cta-card {
    background: var(--ng-dark-navy);
    color: #fff;
    padding: 80px 40px;
  }

  .ng-cta-button {
    display: inline-block;
    background: var(--ng-blue);
    color: #fff;
    padding: 20px 45px;
    text-decoration: none;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 15px;
    transition: background 0.3s;
    margin-top: 40px;
  }

  @media (max-width: 1024px) {
    .ng-capabilities-grid {
      grid-template-columns: 1fr;
      gap: 60px;
    }
  }

  @media (max-width: 768px) {
    .ng-h1 { font-size: 38px; }
    .ng-h2 { font-size: 32px; }
    .ng-hero-content { padding: 40px; }
  }
</style>
