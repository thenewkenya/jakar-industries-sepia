---
import BaseLayout from '../components/BaseLayout.astro';
---

<BaseLayout title="Capabilities — Jakar Industries" description="Explore our advanced mission technology and strategic platform capabilities.">
  <div class="minimal-layout">
    <!-- Hero Section -->
    <div class="minimal-hero">
      <video class="minimal-hero-video" autoplay loop muted playsinline>
        <source src="/videos/hero-capabilities.mp4" type="video/mp4" />
      </video>
      <div class="minimal-hero-overlay">
        <div class="minimal-hero-content">
          <h1 class="minimal-h1">Capabilities</h1>
          <p class="minimal-subtitle">Advanced engineering for the modern mission</p>
        </div>
      </div>
    </div>

    <!-- Dark Breadcrumb Bar -->
    <div class="minimal-breadcrumb-bar">
      <nav class="minimal-breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li class="minimal-sep">></li>
          <li class="current">Capabilities</li>
        </ol>
      </nav>
    </div>

    <!-- Dark Content Area -->
    <div class="minimal-dark-content">
      <div class="minimal-container">
        <div class="minimal-intro-section">
          <h2 class="minimal-h2">Mission Excellence</h2>
          <p class="minimal-p">Jakar Industries provides high-end technological advantages across multiple domains. Our focus on rapid innovation and mission-proven reliability ensures that our partners stay ahead of emerging threats through superior engineering and operational expertise.</p>
        </div>

        <div class="minimal-capabilities-grid">
          <div class="minimal-cap-item">
            <h3 class="minimal-h3-alt">Advanced Sensors</h3>
            <p class="minimal-p">Multispectral sensing systems providing real-time intelligence in degraded environments. Our sensor suites are designed for maximum situational awareness and seamless data integration.</p>
            <ul class="minimal-list-alt">
              <li><strong class="minimal-accent-text">Imaging:</strong> <span class="minimal-gray-text">Thermal & IR high-res systems</span></li>
              <li><strong class="minimal-accent-text">LIDAR:</strong> <span class="minimal-gray-text">Advanced terrain mapping</span></li>
              <li><strong class="minimal-accent-text">ESM:</strong> <span class="minimal-gray-text">Electronic support measures</span></li>
            </ul>
          </div>

          <div class="minimal-cap-item">
            <h3 class="minimal-h3-alt">Autonomous Systems</h3>
            <p class="minimal-p">Next-generation drones and ground robotic systems capable of autonomous navigation, threat detection, and collaborative operations in contested areas.</p>
            <ul class="minimal-list-alt">
              <li><strong class="minimal-accent-text">AI Swarms:</strong> <span class="minimal-gray-text">Collaborative unit intelligence</span></li>
              <li><strong class="minimal-accent-text">Edge AI:</strong> <span class="minimal-gray-text">Real-time processing power</span></li>
              <li><strong class="minimal-accent-text">Endurance:</strong> <span class="minimal-gray-text">Ultra-long mission logistics</span></li>
            </ul>
          </div>
        </div>

        <!-- Platforms Section -->
        <div class="minimal-platforms-section">
          <h2 class="minimal-h2">Strategic Platforms</h2>
          <div class="minimal-platform-row">
            <div class="minimal-platform-card">
              <div class="minimal-platform-info">
                <h3 class="minimal-h3">Aegis Drone Fleet</h3>
                <p class="minimal-p">The Aegis platform represents the pinnacle of aerial surveillance. Capable of 24-hour continuous flight, these systems provide persistent monitoring for border security and disaster response.</p>
              </div>
            </div>
            <div class="minimal-platform-card">
              <div class="minimal-platform-info">
                <h3 class="minimal-h3">Titan Ground Unit</h3>
                <p class="minimal-p">A modular, heavy-duty robotic platform designed for hazardous material handling and extreme terrain navigation. Titan goes where humans cannot.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Final CTA Box -->
        <div class="minimal-cta-section">
          <div class="minimal-cta-card">
            <h2 class="minimal-h2" style="margin-bottom: 20px;">Ready to Transform Your Mission?</h2>
            <p class="minimal-p" style="margin-bottom: 40px;">Learn how our advanced capabilities can give you the operational advantage.</p>
            <a href="/contact" class="minimal-cta-button">Contact Our Experts</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* Dribbble-Inspired Minimalist Dark Constants */
  :root {
    --minimal-black: #000000;
    --minimal-near-black: #0a0a0a;
    --minimal-accent: #0044ff;
    --minimal-white: #ffffff;
    --minimal-gray: #A0A0A0;
    --minimal-border: rgba(255, 255, 255, 0.1);
    --minimal-font: "Inter", -apple-system, sans-serif;
    --minimal-container: 1200px;
  }

  .minimal-layout {
    background: var(--minimal-black);
    color: var(--minimal-white);
    font-family: var(--minimal-font);
    -webkit-font-smoothing: antialiased;
  }

  /* Hero Section */
  .minimal-hero {
    position: relative;
    height: 70vh;
    min-height: 550px;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .minimal-hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.5;
  }

  .minimal-hero-overlay {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: var(--minimal-container);
    margin: 0 auto;
    padding: 0 40px;
  }

  .minimal-hero-content {
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    padding: 60px;
    max-width: 800px;
    border: 1px solid var(--minimal-border);
  }

  .minimal-h1 {
    font-size: clamp(48px, 8vw, 72px);
    font-weight: 800;
    margin: 0 0 20px;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .minimal-subtitle {
    font-size: clamp(18px, 2vw, 24px);
    margin: 0;
    line-height: 1.4;
    font-weight: 400;
    color: var(--minimal-gray);
  }

  /* Breadcrumb Bar */
  .minimal-breadcrumb-bar {
    background: var(--minimal-near-black);
    border-bottom: 1px solid var(--minimal-border);
    padding: 20px 0;
  }

  .minimal-breadcrumb {
    width: 100%;
    max-width: var(--minimal-container);
    margin: 0 auto;
    padding: 0 40px;
  }

  .minimal-breadcrumb ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .minimal-breadcrumb li {
    font-size: 13px;
    font-weight: 600;
    color: var(--minimal-gray);
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }

  .minimal-breadcrumb a {
    color: var(--minimal-white);
    text-decoration: none;
  }

  .minimal-sep { opacity: 0.3; }

  /* Content Area */
  .minimal-dark-content {
    background: var(--minimal-black);
    padding: 120px 0;
  }

  .minimal-container {
    max-width: var(--minimal-container);
    margin: 0 auto;
    padding: 0 40px;
  }

  .minimal-h2 {
    font-size: 40px;
    font-weight: 700;
    margin: 0 0 30px;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .minimal-p {
    font-size: 18px;
    line-height: 1.8;
    color: var(--minimal-gray);
    margin-bottom: 40px;
  }

  .minimal-capabilities-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 100px;
    margin: 80px 0;
  }

  .minimal-cap-item {
    border-top: 1px solid var(--minimal-border);
    padding-top: 40px;
  }

  .minimal-h3-alt {
    font-size: 32px;
    font-weight: 700;
    margin-bottom: 25px;
    color: var(--minimal-white);
  }

  .minimal-list-alt {
    list-style: none;
    padding: 0;
    margin: 30px 0 0;
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .minimal-accent-text {
    color: var(--minimal-white);
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .minimal-gray-text { color: var(--minimal-gray); }

  /* Platforms Section */
  .minimal-platforms-section {
    padding: 100px 0;
    border-top: 1px solid var(--minimal-border);
  }

  .minimal-platform-row {
    display: grid;
    gap: 40px;
    margin-top: 60px;
  }

  .minimal-platform-card {
    background: var(--minimal-near-black);
    padding: 60px;
    border: 1px solid var(--minimal-border);
    transition: border-color 0.3s;
  }

  .minimal-platform-card:hover {
    border-color: var(--minimal-accent);
  }

  .minimal-h3 {
    font-size: 28px;
    font-weight: 700;
    margin-bottom: 20px;
  }

  /* CTA Section */
  .minimal-cta-section {
    padding: 120px 0 0;
  }

  .minimal-cta-card {
    background: linear-gradient(135deg, #050505 0%, #111 100%);
    border: 1px solid var(--minimal-border);
    padding: 100px 60px;
    text-align: center;
  }

  .minimal-cta-button {
    display: inline-block;
    background: var(--minimal-white);
    color: var(--minimal-black);
    padding: 20px 50px;
    text-decoration: none;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-size: 14px;
    transition: all 0.3s;
  }

  .minimal-cta-button:hover {
    background: var(--minimal-accent);
    color: var(--minimal-white);
    transform: translateY(-2px);
  }

  @media (max-width: 1024px) {
    .minimal-capabilities-grid { grid-template-columns: 1fr; gap: 60px; }
  }

  @media (max-width: 768px) {
    .minimal-h1 { font-size: 40px; }
    .minimal-h2 { font-size: 32px; }
    .minimal-hero-content { padding: 40px; }
    .minimal-platform-card { padding: 40px; }
  }
</style>
