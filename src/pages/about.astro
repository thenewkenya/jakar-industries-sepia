---
import BaseLayout from '../components/BaseLayout.astro';
---

<BaseLayout title="About — Jakar Industries" description="Learn about Jakar Industries' mission, values, and commitment to defense technology.">
  <div class="minimal-layout">
    <!-- Hero Section -->
    <div class="minimal-hero">
      <video class="minimal-hero-video" autoplay loop muted playsinline>
        <source src="/videos/hero-about.mp4" type="video/mp4" />
      </video>
      <div class="minimal-hero-overlay">
        <div class="minimal-hero-content">
          <h1 class="minimal-h1">About Us</h1>
          <p class="minimal-subtitle">Leading the transformation of mission-critical technology</p>
        </div>
      </div>
    </div>

    <!-- Dark Breadcrumb Bar -->
    <div class="minimal-breadcrumb-bar">
      <nav class="minimal-breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li class="minimal-sep">></li>
          <li class="current">About Us</li>
        </ol>
      </nav>
    </div>

    <!-- Dark Content Area -->
    <div class="minimal-dark-content">
      <div class="minimal-container">
        <div class="minimal-main-grid">
          <div class="minimal-main-col">
            <h2 class="minimal-h2">Our Mission</h2>
            <p class="minimal-p">At Jakar Industries, we are dedicated to pioneering innovative technologies that empower military and first responders worldwide. We believe that cutting-edge engineering, unwavering reliability, and deep mission understanding create the foundation for solutions that save lives and advance national security.</p>
            
            <h2 class="minimal-h2">Who We Are</h2>
            <p class="minimal-p">Founded on principles of precision, innovation, and service, Jakar Industries has become a trusted partner for defense and public safety organizations. Our team of engineers, technologists, and mission experts work collaboratively to deliver solutions that meet the most demanding requirements in the world's most challenging environments.</p>
            <p class="minimal-p">We combine decades of defense industry experience with cutting-edge research and development to create systems that perform flawlessly under pressure. From combat zones to disaster areas, our technology enables those who serve to accomplish their missions with confidence.</p>
          </div>
          
          <aside class="minimal-side-col">
            <div class="minimal-sidebar-card">
              <h3 class="minimal-h3">Core Values</h3>
              <ul class="minimal-list">
                <li><strong class="minimal-accent-text">Innovation:</strong> Pushing boundaries</li>
                <li><strong class="minimal-accent-text">Reliability:</strong> Mission-proven</li>
                <li><strong class="minimal-accent-text">Service:</strong> Dedicated support</li>
                <li><strong class="minimal-accent-text">Security:</strong> Operational integrity</li>
              </ul>
            </div>
          </aside>
        </div>

        <!-- Section Break / Stats -->
        <div class="minimal-stats-section">
          <h2 class="minimal-h2">By The Numbers</h2>
          <div class="minimal-stats-grid">
            <div class="minimal-stat-item">
              <strong class="minimal-stat-num">25+</strong>
              <span class="minimal-stat-label">Years of Excellence</span>
            </div>
            <div class="minimal-stat-item">
              <strong class="minimal-stat-num">500+</strong>
              <span class="minimal-stat-label">Dedicated Experts</span>
            </div>
            <div class="minimal-stat-item">
              <strong class="minimal-stat-num">50+</strong>
              <span class="minimal-stat-label">Global Partnerships</span>
            </div>
            <div class="minimal-stat-item">
              <strong class="minimal-stat-num">1000+</strong>
              <span class="minimal-stat-label">Deployed Systems</span>
            </div>
          </div>
        </div>

        <!-- Leadership -->
        <div class="minimal-leadership-section">
          <h2 class="minimal-h2">Leadership</h2>
          <div class="minimal-leaders-grid">
            <div class="minimal-leader">
              <strong class="minimal-leader-name">Dr. Sarah Mitchell</strong>
              <span class="minimal-leader-title">CEO</span>
              <p class="minimal-p">Former Vice President of Advanced Systems at leading defense contractor with 20+ years experience.</p>
            </div>
            <div class="minimal-leader">
              <strong class="minimal-leader-name">James Rodriguez</strong>
              <span class="minimal-leader-title">CTO</span>
              <p class="minimal-p">Pioneer in autonomous systems and AI integration, with distinguished career in military technology.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* Dribbble-Inspired Minimalist Dark Constants */
  :root {
    --minimal-black: #000000;
    --minimal-near-black: #0a0a0a;
    --minimal-accent: #0044ff; /* Cinematic Jakar Blue */
    --minimal-white: #ffffff;
    --minimal-gray: #A0A0A0;
    --minimal-border: rgba(255, 255, 255, 0.1);
    --minimal-font: "Inter", -apple-system, sans-serif;
    --minimal-container: 1200px;
  }

  .minimal-layout {
    background: var(--minimal-black);
    color: var(--minimal-white);
    font-family: var(--minimal-font);
    -webkit-font-smoothing: antialiased;
  }

  /* Hero Section */
  .minimal-hero {
    position: relative;
    height: 80vh;
    min-height: 600px;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .minimal-hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.6; /* Cinematic dimming */
  }

  .minimal-hero-overlay {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: var(--minimal-container);
    margin: 0 auto;
    padding: 0 40px;
  }

  .minimal-hero-content {
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    padding: 60px;
    max-width: 800px;
    border: 1px solid var(--minimal-border);
  }

  .minimal-h1 {
    font-size: clamp(48px, 8vw, 72px);
    font-weight: 800;
    margin: 0 0 20px;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .minimal-subtitle {
    font-size: clamp(18px, 2vw, 24px);
    margin: 0;
    line-height: 1.4;
    font-weight: 400;
    color: var(--minimal-gray);
  }

  /* Breadcrumb Bar */
  .minimal-breadcrumb-bar {
    background: var(--minimal-near-black);
    border-bottom: 1px solid var(--minimal-border);
    padding: 20px 0;
  }

  .minimal-breadcrumb {
    width: 100%;
    max-width: var(--minimal-container);
    margin: 0 auto;
    padding: 0 40px;
  }

  .minimal-breadcrumb ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .minimal-breadcrumb li {
    font-size: 14px;
    font-weight: 500;
    color: var(--minimal-gray);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .minimal-breadcrumb a {
    color: var(--minimal-white);
    text-decoration: none;
    transition: color 0.2s;
  }

  .minimal-breadcrumb a:hover {
    color: var(--minimal-accent);
  }

  .minimal-sep {
    opacity: 0.3;
  }

  /* Content Area */
  .minimal-dark-content {
    background: var(--minimal-black);
    padding: 120px 0;
  }

  .minimal-container {
    max-width: var(--minimal-container);
    margin: 0 auto;
    padding: 0 40px;
  }

  .minimal-main-grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 100px;
    margin-bottom: 120px;
  }

  .minimal-h2 {
    font-size: 44px;
    font-weight: 700;
    margin: 0 0 40px;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .minimal-p {
    font-size: 18px;
    line-height: 1.8;
    color: var(--minimal-gray);
    margin-bottom: 40px;
  }

  .minimal-sidebar-card {
    border: 1px solid var(--minimal-border);
    padding: 40px;
    position: sticky;
    top: 100px;
  }

  .minimal-h3 {
    font-size: 24px;
    font-weight: 700;
    margin-bottom: 30px;
  }

  .minimal-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .minimal-list li {
    font-size: 16px;
    margin-bottom: 20px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    color: var(--minimal-gray);
  }

  .minimal-accent-text {
    color: var(--minimal-white);
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Stats Section */
  .minimal-stats-section {
    padding: 120px 0;
    border-top: 1px solid var(--minimal-border);
  }

  .minimal-stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 40px;
    margin-top: 60px;
  }

  .minimal-stat-item {
    border-left: 1px solid var(--minimal-border);
    padding-left: 30px;
  }

  .minimal-stat-num {
    display: block;
    font-size: 64px;
    font-weight: 800;
    line-height: 1;
    margin-bottom: 15px;
    background: linear-gradient(135deg, #fff 0%, #666 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .minimal-stat-label {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--minimal-gray);
  }

  /* Leadership */
  .minimal-leadership-section {
    padding: 120px 0;
    border-top: 1px solid var(--minimal-border);
  }

  .minimal-leaders-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 80px;
    margin-top: 60px;
  }

  .minimal-leader-name {
    font-size: 28px;
    display: block;
    margin-bottom: 10px;
  }

  .minimal-leader-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--minimal-accent);
    text-transform: uppercase;
    display: block;
    margin-bottom: 25px;
    letter-spacing: 0.1em;
  }

  @media (max-width: 1024px) {
    .minimal-main-grid { grid-template-columns: 1fr; gap: 60px; }
    .minimal-stats-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 768px) {
    .minimal-h1 { font-size: 40px; }
    .minimal-h2 { font-size: 32px; }
    .minimal-hero-content { padding: 40px; }
    .minimal-stats-grid { grid-template-columns: 1fr; }
  }
</style>
