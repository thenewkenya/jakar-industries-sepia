---
import BaseLayout from '../components/BaseLayout.astro';
---

<BaseLayout title="Contact Us — Jakar Industries" description="Get in touch with Jakar Industries for mission support and technology inquiries.">
  <div class="minimal-layout">
    <!-- Hero Section -->
    <div class="minimal-hero">
      <video class="minimal-hero-video" autoplay loop muted playsinline>
        <source src="/videos/hero-contact.mp4" type="video/mp4" />
      </video>
      <div class="minimal-hero-overlay">
        <div class="minimal-hero-content">
          <h1 class="minimal-h1">Contact Us</h1>
          <p class="minimal-subtitle">Dedicated support for your critical missions</p>
        </div>
      </div>
    </div>

    <!-- Dark Breadcrumb Bar -->
    <div class="minimal-breadcrumb-bar">
      <nav class="minimal-breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li class="minimal-sep">></li>
          <li class="current">Contact Us</li>
        </ol>
      </nav>
    </div>

    <!-- Dark Content Area -->
    <div class="minimal-dark-content">
      <div class="minimal-container">
        <div class="minimal-main-grid">
          <div class="minimal-main-col">
            <h2 class="minimal-h2">Get in Touch</h2>
            <p class="minimal-p">Have a question about our technology or need support for an ongoing operation? Our team of mission experts is standing by to assist you.</p>
            
            <form class="minimal-form">
              <div class="minimal-form-row">
                <div class="minimal-form-group">
                  <label for="name">Full Name</label>
                  <input type="text" id="name" name="name" required placeholder="John Doe" />
                </div>
                <div class="minimal-form-group">
                  <label for="email">Work Email</label>
                  <input type="email" id="email" name="email" required placeholder="john@organization.com" />
                </div>
              </div>
              <div class="minimal-form-group">
                <label for="organization">Organization</label>
                <input type="text" id="organization" name="organization" required placeholder="Department / Agency / Company" />
              </div>
              <div class="minimal-form-group">
                <label for="subject">Subject</label>
                <select id="subject" name="subject">
                  <option value="general">General Inquiry</option>
                  <option value="support">Mission Support</option>
                  <option value="sales">Technology Procurement</option>
                  <option value="partnership">Strategic Partnership</option>
                </select>
              </div>
              <div class="minimal-form-group">
                <label for="message">Message</label>
                <textarea id="message" name="message" rows="6" required placeholder="How can we help your mission?"></textarea>
              </div>
              <button type="submit" class="minimal-form-button">Submit Request</button>
            </form>
          </div>
          
          <aside class="minimal-side-col">
            <div class="minimal-sidebar-card">
              <h3 class="minimal-h3">Headquarters</h3>
              <p class="minimal-p-side">
                <strong>Jakar Industries</strong><br />
                Innovation Square, Pentagon City<br />
                Arlington, VA 22202<br />
                United States
              </p>
              
              <div class="minimal-divider"></div>

              <h3 class="minimal-h3">Mission Support</h3>
              <p class="minimal-p-side">
                <strong>24/7 Operations:</strong><br />
                <span class="minimal-white-text">+1 (800) 555-0199</span><br /><br />
                <strong>Email:</strong><br />
                <span class="minimal-white-text">support@jakarindustries.com</span>
              </p>
            </div>

            <div class="minimal-urgent-box">
              <h3 class="minimal-h3-small">Urgent?</h3>
              <p class="minimal-p-small">For active mission-critical support, please use our priority 24/7 line.</p>
            </div>
          </aside>
        </div>

        <!-- FAQ Section -->
        <div class="minimal-faq-section">
          <h2 class="minimal-h2">FAQs</h2>
          <div class="minimal-faq-grid">
            <div class="minimal-faq-item">
              <h4 class="minimal-h4">Do you provide custom engineering?</h4>
              <p class="minimal-p-small">Yes, we specialize in adapting our core technologies to meet specific operational requirements and environmental constraints.</p>
            </div>
            <div class="minimal-faq-item">
              <h4 class="minimal-h4">How do I request a demo?</h4>
              <p class="minimal-p-small">Demonstrations can be requested via the contact form. Please specify your organization and technology platform of interest.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* Dribbble-Inspired Minimalist Dark Constants */
  :root {
    --minimal-black: #000000;
    --minimal-near-black: #0a0a0a;
    --minimal-accent: #0044ff;
    --minimal-white: #ffffff;
    --minimal-gray: #A0A0A0;
    --minimal-border: rgba(255, 255, 255, 0.1);
    --minimal-font: "Inter", -apple-system, sans-serif;
    --minimal-container: 1200px;
  }

  .minimal-layout {
    background: var(--minimal-black);
    color: var(--minimal-white);
    font-family: var(--minimal-font);
    -webkit-font-smoothing: antialiased;
  }

  /* Hero Section */
  .minimal-hero {
    position: relative;
    height: 70vh;
    min-height: 550px;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .minimal-hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.5;
  }

  .minimal-hero-overlay {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: var(--minimal-container);
    margin: 0 auto;
    padding: 0 40px;
  }

  .minimal-hero-content {
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    padding: 60px;
    max-width: 800px;
    border: 1px solid var(--minimal-border);
  }

  .minimal-h1 {
    font-size: clamp(48px, 8vw, 72px);
    font-weight: 800;
    margin: 0 0 20px;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .minimal-subtitle {
    font-size: clamp(18px, 2vw, 24px);
    margin: 0;
    line-height: 1.4;
    font-weight: 400;
    color: var(--minimal-gray);
  }

  /* Breadcrumb Bar */
  .minimal-breadcrumb-bar {
    background: var(--minimal-near-black);
    border-bottom: 1px solid var(--minimal-border);
    padding: 20px 0;
  }

  .minimal-breadcrumb {
    width: 100%;
    max-width: var(--minimal-container);
    margin: 0 auto;
    padding: 0 40px;
  }

  .minimal-breadcrumb ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .minimal-breadcrumb li {
    font-size: 13px;
    font-weight: 600;
    color: var(--minimal-gray);
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }

  .minimal-breadcrumb a { color: var(--minimal-white); text-decoration: none; }
  .minimal-sep { opacity: 0.3; }

  /* Content Area */
  .minimal-dark-content {
    background: var(--minimal-black);
    padding: 120px 0;
  }

  .minimal-container {
    max-width: var(--minimal-container);
    margin: 0 auto;
    padding: 0 40px;
  }

  .minimal-main-grid {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 100px;
    margin-bottom: 120px;
  }

  .minimal-h2 {
    font-size: 40px;
    font-weight: 700;
    margin: 0 0 30px;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .minimal-p {
    font-size: 18px;
    line-height: 1.8;
    color: var(--minimal-gray);
    margin-bottom: 40px;
  }

  .minimal-form {
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  .minimal-form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
  }

  .minimal-form-group {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .minimal-form-group label {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--minimal-white);
    letter-spacing: 0.1em;
  }

  .minimal-form-group input,
  .minimal-form-group select,
  .minimal-form-group textarea {
    background: var(--minimal-near-black);
    padding: 18px;
    border: 1px solid var(--minimal-border);
    font-family: inherit;
    font-size: 16px;
    color: var(--minimal-white);
    transition: all 0.3s;
  }

  .minimal-form-group input:focus,
  .minimal-form-group select:focus,
  .minimal-form-group textarea:focus {
    outline: none;
    border-color: var(--minimal-accent);
    box-shadow: 0 0 0 1px var(--minimal-accent);
  }

  .minimal-form-button {
    background: var(--minimal-white);
    color: var(--minimal-black);
    padding: 20px 50px;
    border: none;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    cursor: pointer;
    font-size: 14px;
    width: fit-content;
    transition: all 0.3s;
    margin-top: 20px;
  }

  .minimal-form-button:hover {
    background: var(--minimal-accent);
    color: var(--minimal-white);
  }

  .minimal-sidebar-card {
    border: 1px solid var(--minimal-border);
    padding: 40px;
  }

  .minimal-h3 {
    font-size: 22px;
    font-weight: 700;
    margin-bottom: 25px;
    letter-spacing: -0.01em;
  }

  .minimal-p-side {
    font-size: 16px;
    line-height: 1.7;
    color: var(--minimal-gray);
    margin-bottom: 0;
  }

  .minimal-white-text { color: var(--minimal-white); font-weight: 600; }

  .minimal-divider {
    height: 1px;
    background: var(--minimal-border);
    margin: 40px 0;
  }

  .minimal-urgent-box {
    margin-top: 30px;
    background: rgba(208, 2, 27, 0.05); /* Very subtle red glow */
    border: 1px solid rgba(208, 2, 27, 0.2);
    padding: 40px;
  }

  .minimal-h3-small {
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 15px;
    color: #D0021B; /* Priority Red */
  }

  .minimal-p-small {
    font-size: 15px;
    line-height: 1.6;
    color: var(--minimal-gray);
    margin: 0;
  }

  /* FAQ */
  .minimal-faq-section {
    padding-top: 100px;
    border-top: 1px solid var(--minimal-border);
  }

  .minimal-faq-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 80px;
    margin-top: 60px;
  }

  .minimal-h4 {
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 20px;
  }

  @media (max-width: 1024px) {
    .minimal-main-grid { grid-template-columns: 1fr; }
    .minimal-form-row { grid-template-columns: 1fr; }
    .minimal-faq-grid { grid-template-columns: 1fr; gap: 40px; }
  }

  @media (max-width: 768px) {
    .minimal-h1 { font-size: 40px; }
    .minimal-h2 { font-size: 32px; }
    .minimal-hero-content { padding: 40px; }
  }
</style>
