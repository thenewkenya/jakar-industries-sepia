---
import BaseLayout from '../components/BaseLayout.astro';
---

<BaseLayout title="Contact Us — Jakar Industries" description="Get in touch with Jakar Industries for mission support and technology inquiries.">
  <div class="ng-layout">
    <!-- Hero Section -->
    <div class="ng-hero">
      <video class="ng-hero-video" autoplay loop muted playsinline>
        <source src="/videos/hero-contact.mp4" type="video/mp4" />
      </video>
      <div class="ng-hero-overlay">
        <div class="ng-hero-content">
          <h1 class="ng-h1">Contact Us</h1>
          <p class="ng-subtitle">Dedicated support for your critical missions</p>
        </div>
      </div>
    </div>

    <!-- Black Breadcrumb Bar -->
    <div class="ng-breadcrumb-bar">
      <nav class="ng-breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li class="ng-sep">></li>
          <li class="current">Contact Us</li>
        </ol>
      </nav>
    </div>

    <!-- White Content Area -->
    <div class="ng-white-content">
      <div class="ng-container">
        <div class="ng-main-grid">
          <div class="ng-main-col">
            <h2 class="ng-h2">Get in Touch</h2>
            <p class="ng-p">Have a question about our technology or need support for an ongoing operation? Our team of mission experts is standing by to assist you.</p>
            
            <form class="ng-form">
              <div class="ng-form-row">
                <div class="ng-form-group">
                  <label for="name">Full Name</label>
                  <input type="text" id="name" name="name" required placeholder="John Doe" />
                </div>
                <div class="ng-form-group">
                  <label for="email">Work Email</label>
                  <input type="email" id="email" name="email" required placeholder="john@organization.com" />
                </div>
              </div>
              <div class="ng-form-group">
                <label for="organization">Organization</label>
                <input type="text" id="organization" name="organization" required placeholder="Department / Agency / Company" />
              </div>
              <div class="ng-form-group">
                <label for="subject">Subject</label>
                <select id="subject" name="subject">
                  <option value="general">General Inquiry</option>
                  <option value="support">Mission Support</option>
                  <option value="sales">Technology Procurement</option>
                  <option value="partnership">Strategic Partnership</option>
                </select>
              </div>
              <div class="ng-form-group">
                <label for="message">Message</label>
                <textarea id="message" name="message" rows="6" required placeholder="How can we help your mission?"></textarea>
              </div>
              <button type="submit" class="ng-form-button">Submit Request</button>
            </form>
          </div>
          
          <aside class="ng-side-col">
            <div class="ng-sidebar-card">
              <h3 class="ng-h3-small">Global Headquarters</h3>
              <p class="ng-p-small">
                <strong>Jakar Industries</strong><br />
                Innovation Square, Pentagon City<br />
                Arlington, VA 22202<br />
                United States
              </p>
              
              <h3 class="ng-h3-small" style="margin-top: 40px;">Mission Support</h3>
              <p class="ng-p-small">
                <strong>24/7 Operations:</strong> +1 (800) 555-0199<br />
                <strong>Email:</strong> support@jakarindustries.com
              </p>
            </div>

            <div class="ng-urgent-box">
              <h3 class="ng-h3-small">Urgent Inquiry?</h3>
              <p class="ng-p-small">For active mission-critical support, please use the 24/7 operations line for immediate assistance.</p>
            </div>
          </aside>
        </div>

        <!-- FAQ Section -->
        <div class="ng-faq-section">
          <h2 class="ng-h2">Frequently Asked Questions</h2>
          <div class="ng-faq-grid">
            <div class="ng-faq-item">
              <h4 class="ng-h4">Do you provide custom engineering?</h4>
              <p class="ng-p-small">Yes, we specialize in adapting our core technologies to meet specific operational requirements and environmental constraints.</p>
            </div>
            <div class="ng-faq-item">
              <h4 class="ng-h4">How do I request a demo?</h4>
              <p class="ng-p-small">Demonstrations can be requested via the contact form. Please specify your organization and the technology platform of interest.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* 1-to-1 Northrop Grumman Constants */
  :root {
    --ng-blue: #00269A;
    --ng-dark-navy: #002554;
    --ng-black: #000000;
    --ng-header-grey: #222222;
    --ng-body-grey: #444444;
    --ng-breadcrumb-link: #E9EBED;
    --ng-breadcrumb-active: #7C878E;
    --ng-font: "Inter", Arial, sans-serif;
    --ng-container-width: 1140px;
  }

  .ng-layout {
    background: var(--ng-black);
    font-family: var(--ng-font);
    -webkit-font-smoothing: antialiased;
  }

  /* Hero Section */
  .ng-hero {
    position: relative;
    height: 70vh;
    min-height: 550px;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .ng-hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ng-hero-overlay {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: var(--ng-container-width);
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  /* Exact 1-for-1 NG Overlay Styles */
  .ng-hero-content {
    background: rgba(0, 0, 0, 0.5); /* 50% Opacity */
    backdrop-filter: blur(5px);    /* 5px Blur */
    -webkit-backdrop-filter: blur(5px);
    padding: 40px;                 /* 40px Padding */
    color: #fff;
    border: none;
    text-align: left;
    max-width: 1140px;
    width: auto;
  }

  .ng-h1 {
    font-size: 52px;
    font-weight: 700;
    margin: 0 0 20px;
    line-height: 1.1;
  }

  .ng-subtitle {
    font-size: 24px;
    margin: 0;
    line-height: 1.4;
    font-weight: 400;
    opacity: 0.95;
  }

  /* Breadcrumb Bar */
  .ng-breadcrumb-bar {
    background: var(--ng-black);
    height: 70px;
    display: flex;
    align-items: center;
  }

  .ng-breadcrumb {
    width: 100%;
    max-width: var(--ng-container-width);
    margin: 0 auto;
    padding: 0 40px;
  }

  .ng-breadcrumb ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ng-breadcrumb li {
    font-size: 19.8px;
    font-weight: 500;
    color: var(--ng-breadcrumb-active);
  }

  .ng-breadcrumb a {
    color: var(--ng-breadcrumb-link);
    text-decoration: none;
  }

  .ng-sep {
    color: var(--ng-breadcrumb-active);
    font-size: 16px;
  }

  /* Main Content Area */
  .ng-white-content {
    background: #fff;
    color: var(--ng-body-grey);
    padding: 80px 0;
  }

  .ng-container {
    max-width: var(--ng-container-width);
    margin: 0 auto;
    padding: 0 40px;
  }

  .ng-main-grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 80px;
    margin-bottom: 80px;
  }

  .ng-h2 {
    font-size: 44px;
    font-weight: 700;
    color: var(--ng-header-grey);
    margin: 0 0 30px;
    line-height: 1.2;
  }

  .ng-p {
    font-size: 18px;
    line-height: 1.75;
    margin-bottom: 30px;
  }

  .ng-form {
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  .ng-form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
  }

  .ng-form-group {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .ng-form-group label {
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--ng-header-grey);
    letter-spacing: 0.1em;
  }

  .ng-form-group input,
  .ng-form-group select,
  .ng-form-group textarea {
    padding: 15px;
    border: 1px solid #ddd;
    border-radius: 2px;
    font-family: inherit;
    font-size: 16px;
  }

  .ng-form-group input:focus {
    outline: none;
    border-color: var(--ng-blue);
  }

  .ng-form-button {
    background: var(--ng-blue);
    color: #fff;
    padding: 20px 45px;
    border: none;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
    font-size: 15px;
    width: fit-content;
    transition: background 0.3s;
  }

  .ng-sidebar-card {
    background: #F2F4F5;
    padding: 40px;
    border-top: 5px solid var(--ng-blue);
  }

  .ng-h3-small {
    font-size: 20px;
    font-weight: 700;
    color: var(--ng-header-grey);
    margin-bottom: 20px;
    text-transform: uppercase;
  }

  .ng-p-small {
    font-size: 16px;
    line-height: 1.6;
    margin: 0;
  }

  .ng-urgent-box {
    margin-top: 30px;
    background: #002244;
    color: #fff;
    padding: 40px;
    border-left: 5px solid #D0021B; /* Alarm red */
  }

  /* FAQ */
  .ng-faq-section {
    padding-top: 80px;
    border-top: 1px solid #E5E5E5;
  }

  .ng-faq-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 60px;
    margin-top: 40px;
  }

  .ng-h4 {
    font-size: 20px;
    font-weight: 700;
    color: var(--ng-header-grey);
    margin-bottom: 15px;
  }

  @media (max-width: 1024px) {
    .ng-main-grid {
      grid-template-columns: 1fr;
    }
    .ng-form-row {
      grid-template-columns: 1fr;
    }
    .ng-faq-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .ng-h1 { font-size: 38px; }
    .ng-h2 { font-size: 32px; }
    .ng-hero-content { padding: 40px; }
  }
</style>
